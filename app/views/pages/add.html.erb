<h1>Add Book</h1>

<%= form_with model: @book, url: add_path, method: :post do |form| %>

  <div>
    <%= form.label :name, "Book Name" %>
    <%= form.text_field :name %>
  </div>

  <br>

  <div>
    <%= form.label :details, "Book Details" %>
    <br>
    <%= form.text_area :details %>
  </div>

  <br>

  <div>
    <%= form.label :price, "Price" %>
    <%= form.number_field :price, step: 0.01 %>
  </div>

  <br>

  <div>
    <%= form.label :author, "Author" %>
    <%= form.text_field :author %>
  </div>

  <br>

  <div>
    <%= form.label :published_date, "Published Date" %>
    <%= form.date_field :published_date %>
  </div>

  <br>

  <%= form.submit "Add Book" %>

<% end %>

<br>

<%= link_to "Back to Home", root_path %>