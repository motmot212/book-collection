<h1>Book Collection</h1>

<h2>Books</h2>

<% if @books.any? %>
  <ul>
    <% @books.each do |book| %>
      <li>
        <strong><%= book.name %></strong>
        <% if book.author.present? %>
          by <%= book.author %>
        <% end %>
        <% if book.price.present? %>
          | $<%= number_with_precision(book.price, precision: 2) %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No books yet</p>
<% end %>

<hr>

