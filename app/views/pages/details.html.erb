<h1>Most Recent Book</h1>

<% if @book %>

  <h2><%= @book.name %></h2>

  <p>
    <strong>Details:</strong>
  </p>

  <p><%= @book.details %></p>

  <p><strong>Author:</strong> <%= @book.author.presence || "Not provided" %></p>
  <p><strong>Price:</strong> <%= @book.price.present? ? number_to_currency(@book.price) : "Not provided" %></p>
  <p><strong>Published Date:</strong> <%= @book.published_date&.strftime("%B %-d, %Y") || "Not provided" %></p>

<% else %>

  <p>There are no books in the collection.</p>

<% end %>

<br>

<%= link_to "Back to Home", root_path %>
