<h1>Delete Book</h1>

<% if @book %>

  <h2><%= @book.name %></h2>

  <p><%= @book.details %></p>
  <p>Are you sure you want to delete this book?</p>

  <%= form_with url: delete_path, method: :delete do |form| %>
    <%= form.submit "Delete Book" %>
  <% end %>

<% else %>

  <p>There are no books to delete.</p>

<% end %>

<br>

<%= link_to "Back to Home", root_path %>